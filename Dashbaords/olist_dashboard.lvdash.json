    {
      "name": "1689bc77",
      "displayName": "customer_retention_cohort",
      "queryLines": [
        "WITH customer_orders AS (\n",
        "  SELECT\n",
        "    oc.customer_unique_id,\n",
        "    DATE_TRUNC('quarter', oor.order_purchase_timestamp) AS order_quarter\n",
        "  FROM\n",
        "    olist_ecommerce.default.olist_order_records AS oor\n",
        "      INNER JOIN olist_ecommerce.default.olist_customers AS oc\n",
        "        ON oor.customer_id = oc.customer_id\n",
        "  WHERE\n",
        "    oor.order_purchase_timestamp IS NOT NULL\n",
        "    AND oc.customer_unique_id IS NOT NULL\n",
        "),\n",
        "first_purchase AS (\n",
        "  SELECT\n",
        "    customer_unique_id,\n",
        "    MIN(order_quarter) AS cohort_quarter\n",
        "  FROM\n",
        "    customer_orders\n",
        "  GROUP BY\n",
        "    customer_unique_id\n",
        "),\n",
        "cohort_activity AS (\n",
        "  SELECT\n",
        "    fp.cohort_quarter,\n",
        "    CAST(FLOOR(months_between(co.order_quarter, fp.cohort_quarter) / 3) AS INT) AS quarter_number,\n",
        "    COUNT(DISTINCT co.customer_unique_id) AS retained_customers\n",
        "  FROM\n",
        "    customer_orders AS co\n",
        "      INNER JOIN first_purchase AS fp\n",
        "        ON co.customer_unique_id = fp.customer_unique_id\n",
        "  GROUP BY\n",
        "    fp.cohort_quarter,\n",
        "    CAST(FLOOR(months_between(co.order_quarter, fp.cohort_quarter) / 3) AS INT)\n",
        "),\n",
        "cohort_size AS (\n",
        "  SELECT\n",
        "    cohort_quarter,\n",
        "    COUNT(DISTINCT customer_unique_id) AS cohort_size\n",
        "  FROM\n",
        "    first_purchase\n",
        "  GROUP BY\n",
        "    cohort_quarter\n",
        ")\n",
        "SELECT\n",
        "  ca.cohort_quarter,\n",
        "  ca.quarter_number,\n",
        "  ca.retained_customers,\n",
        "  cs.cohort_size,\n",
        "  ROUND(100.0 * ca.retained_customers / cs.cohort_size, 2) AS retention_pct\n",
        "FROM\n",
        "  cohort_activity AS ca\n",
        "    INNER JOIN cohort_size AS cs\n",
        "      ON ca.cohort_quarter = cs.cohort_quarter\n",
        "ORDER BY\n",
        "  ca.cohort_quarter,\n",
        "  ca.quarter_number"
      ]
    },
    {
      "name": "62e99999",
      "displayName": "experiment",
      "queryLines": [
        "WITH customer_first_order AS (\n",
        "  SELECT\n",
        "    oc.customer_unique_id,\n",
        "    MIN(oor.order_purchase_timestamp) AS first_order_ts,\n",
        "    MODE(oc.customer_state) AS customer_state,\n",
        "    MODE(oc.customer_city) AS customer_city,\n",
        "    AVG(oc.geolocation_lat) AS geolocation_lat,\n",
        "    AVG(oc.geolocation_lng) AS geolocation_lng\n",
        "  FROM\n",
        "    olist_ecommerce.default.olist_customers AS oc\n",
        "      INNER JOIN olist_ecommerce.default.olist_order_records AS oor\n",
        "        ON oc.customer_id = oor.customer_id\n",
        "  GROUP BY\n",
        "    oc.customer_unique_id\n",
        "),\n",
        "customer_orders AS (\n",
        "  SELECT\n",
        "    oc.customer_unique_id,\n",
        "    oor.order_purchase_timestamp\n",
        "  FROM\n",
        "    olist_ecommerce.default.olist_customers AS oc\n",
        "      INNER JOIN olist_ecommerce.default.olist_order_records AS oor\n",
        "        ON oc.customer_id = oor.customer_id\n",
        ")\n",
        "SELECT\n",
        "  o.customer_unique_id,\n",
        "  MODE(fo.first_order_ts) AS first_order_ts,\n",
        "  MODE(fo.customer_state) AS customer_state,\n",
        "  MODE(fo.customer_city) AS customer_city,\n",
        "  AVG(fo.geolocation_lat) AS geolocation_lat,\n",
        "  AVG(fo.geolocation_lng) AS geolocation_lng,\n",
        "  COUNT(*) AS total_orders\n",
        "FROM\n",
        "  customer_orders AS o\n",
        "    LEFT JOIN customer_first_order AS fo\n",
        "      ON o.customer_unique_id = fo.customer_unique_id\n",
        "GROUP BY\n",
        "  o.customer_unique_id"
      ]
    },
